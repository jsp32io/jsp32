CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_NETWORK_MANAGER_MAX_TX_POWER_QDBM=80
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# The device only advertises its service; it does not browse or use an mDNS CLI.
# CONFIG_MDNS_ENABLE_BROWSE is not set
# CONFIG_MDNS_ENABLE_CONSOLE_CLI is not set
# CONFIG_MDNS_MULTIPLE_INSTANCE is not set
# The S25FL128S uses 64 KiB erase blocks outside its parameter sector.
# Allow the flash driver to issue block erase (0xD8) for OTA partitions.
# CONFIG_SPI_FLASH_BYPASS_BLOCK_ERASE is not set
CONFIG_SPI_FLASH_HPM_DIS=y
CONFIG_SPI_FLASH_OVERRIDE_CHIP_DRIVER_LIST=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# The S25FL128S storage region only supports 64 KiB erase blocks.
CONFIG_LITTLEFS_BLOCK_SIZE=65536
CONFIG_LITTLEFS_OBJ_NAME_LEN=255

CONFIG_NETWORK_AP_PREFIX="JSP32"
CONFIG_NETWORK_HTTP_MAX_BODY=1024
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_LOCAL_HOSTNAME="jsp32"
CONFIG_JS_NET_MAX_CONNECTIONS=16
CONFIG_APP_REGISTERS_D_COUNT=2048
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_APP_HTTP_SERVER_MAX_HANDLERS=48
