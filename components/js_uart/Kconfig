menu "JavaScript UART"

    config JS_UART_ENABLED
        bool "Enable the JavaScript UART API"
        default y

    config JS_UART_MAX_PENDING
        int "Maximum pending operations per UART"
        depends on JS_UART_ENABLED
        default 16
        range 1 64

    config JS_UART_DEFAULT_BUFFER_SIZE
        int "Default RX and TX buffer size"
        depends on JS_UART_ENABLED
        default 2048
        range 256 16384

    config JS_UART_MAX_TRANSFER_SIZE
        int "Maximum bytes per read or write"
        depends on JS_UART_ENABLED
        default 4096
        range 64 65536

    config JS_UART_TASK_STACK_SIZE
        int "UART worker task stack size"
        depends on JS_UART_ENABLED
        default 3072
        range 2048 8192

    config JS_UART_TASK_PRIORITY
        int "UART worker task priority"
        depends on JS_UART_ENABLED
        default 5
        range 1 24

endmenu
