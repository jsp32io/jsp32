menu "Application HTTP server"

    config APP_HTTP_SERVER_PORT
        int "HTTP server port"
        default 80
        range 1 65535

    config APP_HTTP_SERVER_MAX_HANDLERS
        int "Maximum URI handlers"
        default 48
        range 12 64

    config APP_HTTP_SERVER_MAX_OPEN_SOCKETS
        int "Maximum open sockets"
        default 7
        range 4 16

    config APP_HTTP_SERVER_TASK_STACK_SIZE
        int "HTTP server task stack size"
        default 8192
        range 4096 32768

endmenu
